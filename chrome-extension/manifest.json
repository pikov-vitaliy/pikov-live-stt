{
    "manifest_version": 3,
    "name": "Pikov LiveSTT",
    "version": "1.0",
    "description": "Pikov LiveSTT: modified in 2026 by Vitaly Pikov; browser-tab transcription based on WhisperLiveKit.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Pikov LiveSTT — начать транскрипцию"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "permissions": [
        "tabCapture",
        "offscreen",
        "activeTab",
        "storage",
        "sidePanel",
        "clipboardWrite"
    ],
    "minimum_chrome_version": "116"
}
